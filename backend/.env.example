# ===================
# Django Settings
# ===================
# Set to False in production
DEBUG=True
# Must be changed to a secure, random string in production
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
# Comma-separated list of allowed hostnames (e.g., yourdomain.com,api.yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# ===================
# Database (PostgreSQL)
# ===================
DB_NAME=realestate_leads
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# ===================
# CORS Settings
# ===================
# Comma-separated list of frontend origins allowed to access the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000
# Set to False in production to enforce CORS_ORIGINS
CORS_ALLOW_ALL=True

# ===================
# External APIs
# ===================

# Apify (Get from https://console.apify.com/)
APIFY_API_KEY=your-apify-api-key-here
# Actor IDs — get from https://console.apify.com/actors
APIFY_ACTOR_GMAP=nwua9Gu5YrADL7ZDj
APIFY_ACTOR_WEB_SCRAPER=your-scraper-actor-id
APIFY_ACTOR_LINKEDIN=your-linkedin-actor-id

# Firecrawl API (Get from https://www.firecrawl.dev/)
# Required for real estate lead web scraping features
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# ===================
# Backend Public URL
# ===================
# Used for webhooks (e.g., from Apify). In production, this should be your public HTTPS URL.
BACKEND_URL=http://localhost:5050

# ===================
# Redis / Celery (Background Tasks)
# ===================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
