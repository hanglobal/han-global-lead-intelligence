[Unit]
Description=Cloudflare Tunnel
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/han-global-lead-intelligence
ExecStart=/usr/local/bin/cloudflared tunnel --config /var/www/han-global-lead-intelligence/config.yml run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target