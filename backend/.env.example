# ===================
# Django Settings
# ===================
# Set to False in production
DEBUG=False
# Must be changed to a secure, random string in production (e.g. 50+ chars)
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
# Comma-separated list of allowed hostnames (e.g., yourdomain.com,api.yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional superuser & user setup defaults for create_users.py
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password
DJANGO_DEFAULT_USER_USERNAME=user
DJANGO_DEFAULT_USER_PASSWORD=your-secure-user-password

# Basic Authentication Settings (used by middleware / API clients)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=your-secure-basic-auth-password

# ===================
# Database (PostgreSQL)
# ===================
DB_NAME=realestate_leads
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# ===================
# CORS Settings
# ===================
# Comma-separated list of frontend origins allowed to access the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://apps.yourdomain.com
# Set to False in production to enforce CORS_ORIGINS
CORS_ALLOW_ALL=False

# ===================
# External APIs
# ===================

# Nexus Data Solutions API
NEXUS_BASE_URL=https://app.nexusdatasolutions.online/api/v1
NEXUS_CLIENT_ID=your-nexus-client-id
NEXUS_CLIENT_SECRET=your-nexus-client-secret

# Firecrawl API (Get from https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# Ollama / Cloud LLM Provider Settings
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=minimax-m2.7:cloud
OLLAMA_API_KEY=your-ollama-api-key-here

# ===================
# Backend Public URL
# ===================
# In production, set to your public backend HTTPS URL.
BACKEND_URL=http://localhost:5050

# ===================
# Redis / Celery (Background Tasks)
# ===================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

