# Backend API URL (client-side calls)
NEXT_PUBLIC_API_URL=http://localhost:5050/api

# Direct internal backend URL (used by Next.js middleware and server-side routes)
BACKEND_INTERNAL_URL=http://127.0.0.1:5050

# ===================
# Environment
# ===================
NEXT_PUBLIC_ENV=development
